results <- lapply(
thresholds,
function(threshold) {
predicted_positive <-
probability >= threshold
true_positive <- sum(
predicted_positive &
outcome == 1
)
false_positive <- sum(
predicted_positive &
outcome == 0
)
net_benefit <-
true_positive / n -
false_positive / n *
threshold / (1 - threshold)
data.frame(
Threshold = threshold,
Net_benefit = net_benefit,
Strategy = model_name
)
}
)
do.call(rbind, results)
}
