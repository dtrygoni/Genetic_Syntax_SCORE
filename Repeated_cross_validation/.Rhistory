color = "grey40"
) +
geom_smooth(
data = long_predictions,
aes(
x = Probability,
y = Outcome,
color = Model
),
method = "loess",
formula = y ~ x,
se = TRUE
) +
geom_point(
data = calibration_points,
aes(
x = Predicted,
y = Observed,
color = Model
),
size = 2.5
) +
coord_equal(
xlim = c(0, 1),
ylim = c(0, 1)
) +
labs(
x = "Predicted probability",
y = "Observed event proportion",
color = "Model"
) +
theme_minimal(base_size = 12)
calibration_plot
