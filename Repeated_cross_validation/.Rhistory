######################## DCA ##################
calculate_net_benefit <- function(
outcome,
probability,
thresholds,
model_name
) {
n <- length(outcome)
results <- lapply(
thresholds,
function(threshold) {
predicted_positive <-
probability >= threshold
true_positive <- sum(
predicted_positive &
outcome == 1
)
false_positive <- sum(
predicted_positive &
outcome == 0
)
net_benefit <-
true_positive / n -
false_positive / n *
threshold / (1 - threshold)
data.frame(
Threshold = threshold,
Net_benefit = net_benefit,
Strategy = model_name
)
}
)
do.call(rbind, results)
}
decision_thresholds <- seq(
0.05,
0.80,
by = 0.01
)
dca_clinical <- calculate_net_benefit(
outcome = evaluation_data$outcome,
probability =
evaluation_data$prob_clinical,
thresholds = decision_thresholds,
model_name = "Model A: Clinical"
)
dca_snp <- calculate_net_benefit(
outcome = evaluation_data$outcome,
probability =
evaluation_data$prob_snp,
thresholds = decision_thresholds,
model_name = "Model B: Clinical+SNPs"
)
dca_clinical
dca_snp
prevalence <- mean(
evaluation_data$outcome == 1
)
dca_treat_all <- data.frame(
Threshold = decision_thresholds,
Net_benefit =
prevalence -
(1 - prevalence) *
decision_thresholds /
(1 - decision_thresholds),
Strategy = "Treat all"
)
dca_treat_none <- data.frame(
Threshold = decision_thresholds,
Net_benefit = 0,
Strategy = "Treat none"
)
dca_results <- rbind(
dca_clinical,
dca_snp,
dca_treat_all,
dca_treat_none
)
dca_results
View(dca_results)
decision_curve_plot <- ggplot(
dca_results,
aes(
x = Threshold,
y = Net_benefit,
color = Strategy,
linetype = Strategy
)
) +
geom_line(linewidth = 1) +
geom_hline(
yintercept = 0,
color = "grey70"
) +
labs(
x = "Threshold probability",
y = "Net benefit",
color = "Strategy",
linetype = "Strategy"
) +
theme_minimal(base_size = 12) +
theme(
legend.position = "bottom"
)
decision_curve_plot
prepare_confusion_data <- function(
confusion_matrix,
model_name
) {
plot_data <- as.data.frame(
confusion_matrix$table
)
names(plot_data) <- c(
"Predicted",
"Observed",
"Count"
)
# Readable outcome labels
plot_data$Predicted <- factor(
plot_data$Predicted,
levels = c("0", "1"),
labels = c(
"Zero",
"Non-zero"
)
)
plot_data$Observed <- factor(
plot_data$Observed,
levels = c("0", "1"),
labels = c(
"Zero",
"Non-zero"
)
)
# Percentage within each observed outcome group
plot_data$Percentage <- ave(
plot_data$Count,
plot_data$Observed,
FUN = function(x) {
100 * x / sum(x)
}
)
# Cell label containing n and percentage
plot_data$Label <- sprintf(
"%d\n(%.1f%%)",
plot_data$Count,
plot_data$Percentage
)
plot_data$Model <- model_name
plot_data
}
clinical_plot_data <- prepare_confusion_data(
clinical_cm,
"Model A: Clinical"
)
snp_plot_data <- prepare_confusion_data(
snp_cm,
"Model B: Clinical + SNPs"
)
confusion_plot_data <- rbind(
clinical_plot_data,
snp_plot_data
)
confusion_matrix_plot <- ggplot(
confusion_plot_data,
aes(
x = Predicted,
y = Observed,
fill = Count
)
) +
geom_tile(
color = "white",
linewidth = 1.2
) +
geom_text(
aes(label = Label),
size = 4.5,
fontface = "bold",
color = "black"
) +
facet_wrap(
~ Model,
nrow = 1
) +
scale_fill_gradient(
low = "#F0F6FC",
high = "#2878B5",
name = "Participants"
) +
coord_equal() +
labs(
x = "Predicted SYNTAX-score group",
y = "Observed SYNTAX-score group"
) +
theme_minimal(
base_size = 12
) +
theme(
panel.grid = element_blank(),
strip.text = element_text(
size = 12,
face = "bold"
),
axis.title = element_text(
size = 11,
face = "bold"
),
axis.text = element_text(
size = 10,
color = "black"
),
legend.position = "bottom",
panel.spacing = grid::unit(
1.5,
"lines"
)
)
confusion_matrix_plot
